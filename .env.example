# Copy to .env in this project root. The app loads it automatically.
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=YOUR_AVAILABLE_GEMINI_MODEL_ID
# Option A (recommended): leave blank; run gcloud auth application-default login.
# Cloud Run also uses a blank value and its attached service account automatically.
GOOGLE_APPLICATION_CREDENTIALS=
# Option B (local only): put your downloaded key JSON in credentials/service-account.json
# and change the value above to credentials/service-account.json
PORT=8080
